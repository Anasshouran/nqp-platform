# ===== NQP — example environment file =====
# انسخ هذا الملف إلى `.env` واملأ القيم الفعلية. لا ترفع `.env` إلى المستودع أبداً.
# أحدث مرجع للمتغيرات: backend/nqp_backend/settings.py

# ===== Django =====
# تحذير: لا تستخدم أحد هذه القيم في الإنتاج — سيتعطل Django عند DEBUG=False:
#   dev-secret-key-change-in-production / your-secret-key-here / dev-secret-key-please-change
SECRET_KEY=generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ===== PostgreSQL =====
# Support both DB_* (legacy) and POSTGRES_* (preferred)
POSTGRES_DB=afyatna
POSTGRES_USER=afyatna
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_NAME=afyatna
DB_USER=afyatna
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ===== Redis =====
# يستخدمها الإعداد لبناء CELERY_BROKER_URL و CELERY_RESULT_BACKEND تلقائياً
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Celery =====
# اختياري: اضبط القيم فقط إذا أردت تجاوز الافتراضي المشتق من REDIS_* أعلاه
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== JWT =====
# مدة التوكن بالثواني
JWT_ACCESS_TOKEN_LIFETIME=1800
JWT_REFRESH_TOKEN_LIFETIME=604800
# اختياري: يستخدم كتوقيع (SIGNING_KEY) لـ simplejwt عند ضبطه، وإلا يُستخدم SECRET_KEY
JWT_SECRET_KEY=change-this-to-a-long-random-string

# ===== MinIO / S3 =====
USE_S3=False
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nqp-documents

# ===== بذر البيانات التجريبية (التطوير فقط) =====
# يجب أن تكون "true" حرفياً حتى تعمل أوامر seed للبيانات التجريبية
SEED_DEMO_USERS=false

# ===== الواجهة الأمامية (Frontend) =====
# عنوان الـ API يُبني داخل صورة الواجهة وقت البناء عبر frontend/.env.production
# (VITE_API_URL=...) وليس متغير إنتاج للنشر.