# ============================================================
# frontend/Dockerfile.dev - بناء بيئة تطوير React + Vite
# ============================================================

FROM node:20-alpine AS development

WORKDIR /app

# تثبيت الاعتماديات
COPY package*.json ./
RUN npm ci --silent

# نسخ الكود
COPY . .

# تعريض المنفذ
EXPOSE 3000

# تشغيل خادم التطوير
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]