# NQP Backend — example environment file
# Copy to .env and fill real values. NEVER commit the filled .env.
# Reference: nqp_backend/settings.py

# --- Core (REQUIRED in production) ---
# Avoid placeholders: dev-secret-key-change-in-production /
#   your-secret-key-here / dev-secret-key-please-change (fail closed when DEBUG=False)
SECRET_KEY=generate-a-long-random-string
DEBUG=False

# Comma-separated public hosts of the API
ALLOWED_HOSTS=nqp.gov.sd,api.nqp.gov.sd

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=afyatna
POSTGRES_USER=afyatna
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_NAME=afyatna
DB_USER=afyatna
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
# Only needed when DEBUG=False; comma-separated frontend origins
CORS_ALLOWED_ORIGINS=https://nqp.gov.sd,https://admin.nqp.gov.sd

# --- JWT (seconds) ---
JWT_ACCESS_TOKEN_LIFETIME=1800
JWT_REFRESH_TOKEN_LIFETIME=604800
# Optional signing key for simplejwt; falls back to SECRET_KEY when unset
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- Security headers (production defaults are on when DEBUG=False) ---
# Set true only when TLS terminates in front of Django
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# --- Celery / Redis ---
# If unset, CELERY_BROKER_URL / CELERY_RESULT_BACKEND are derived from REDIS_* below
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional explicit overrides:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- MinIO / S3 documents storage ---
USE_S3=False
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=nqp-documents
MINIO_ENDPOINT=localhost:9000

# --- Demo data seeding (DEVELOPMENT ONLY) ---
# Must be explicitly "true" for demo-account seed commands to run.
SEED_DEMO_USERS=false