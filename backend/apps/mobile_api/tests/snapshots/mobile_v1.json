                "schema": {
                  "$ref": "#/components/schemas/MobileDeclarationList"
                }
              }
            },
            "description": "سجل الإقرار الأدنى"
          }
        },
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "tags": [
          "mobile",
          "mobile-declarations"
        ]
      },
      "post": {
        "description": "فجوة معتمدة: تدفق تقديم إقرار الجوال غير معتمد بعد (مزامنة M2-C) — 501.",
