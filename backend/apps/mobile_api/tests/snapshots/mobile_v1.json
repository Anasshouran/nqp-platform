            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileDeclaration"
                }
              }
            },
            "description": "قُبل للطابور"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented — مؤجَّل بربط مسوّغ موثق (SUDAPASS/Q8 أو نقص نموذج نطاق)."
          }
        },
        "security": [
          {
            "jwtAuth": []
          }
        ],
        "tags": [
          "mobile",
          "mobile-declarations"
        ]
      }
    },
    "/api/v1/mobile/notifications/": {
      "get": {
        "description": "إشعارات مملوكة للمستخدم فقط — لا إشعارات مؤسسية ولا مستلم/نص داخلي.",
        "operationId": "v1_mobile_notifications_retrieve",
