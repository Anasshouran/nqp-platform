# deploy/staging/.env.example — STAGING CONFIG CONTRACT (NO REAL SECRETS)
# Copy to deploy/staging/.env (GITIGNORED) and fill via env/secrets at deploy time.
DEBUG=False
STAGING_DB_NAME=
STAGING_DB_USER=
STAGING_DB_PASSWORD=<SECRET>
STAGING_BACKEND_IMAGE=ghcr.io/anasshouran/nqp-backend:<tag>
STAGING_FRONTEND_IMAGE=ghcr.io/anasshouran/afyatna-frontend:<tag>
STAGING_ALLOWED_HOSTS=<staging-api-host>
STAGING_CSRF_TRUSTED_ORIGINS=https://<staging-host>
STAGING_CORS_ALLOWED_ORIGINS=https://<staging-host>
STAGING_SECRET_KEY=<SECRET>
STAGING_JWT_SECRET_KEY=<SECRET>
# optional: MINIO for documents/files
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=<SECRET>
MINIO_SECRET_KEY=<SECRET>
MINIO_BUCKET=nqp-staging
