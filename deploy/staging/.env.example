# ============================================================
# deploy/staging/.env.example — STAGING CONFIG CONTRACT (NO REAL SECRETS)
# Copy to deploy/staging/.env (GITIGNORED) and fill via env/secrets at deploy time.
# ============================================================
DEBUG=False

# ===== Immutable release identity (F-03 contract) =====
# Both images MUST reference the same <RELEASE_SHA> (a git short/full SHA tag
# published by the staging CI pipeline). NEVER use `latest`. Rollback = re-pin
# these two lines to a previously known-good <RELEASE_SHA>.
STAGING_BACKEND_IMAGE=ghcr.io/anasshouran/nqp-backend:<RELEASE_SHA>
STAGING_FRONTEND_IMAGE=ghcr.io/anasshouran/afyatna-frontend:<RELEASE_SHA>
# Optional infra image overrides (defaults are the mirrored GHCR base images):
# STAGING_POSTGRES_IMAGE=ghcr.io/anasshouran/postgres:16-alpine
# STAGING_REDIS_IMAGE=ghcr.io/anasshouran/redis:7-alpine

# ===== Django =====
STAGING_DB_NAME=nqp_staging
STAGING_DB_USER=nqp_staging
STAGING_DB_PASSWORD=<SECRET>
STAGING_ALLOWED_HOSTS=<staging-api-host>
STAGING_CSRF_TRUSTED_ORIGINS=https://<staging-host>
STAGING_CORS_ALLOWED_ORIGINS=https://<staging-host>
STAGING_SECRET_KEY=<SECRET>
STAGING_JWT_SECRET_KEY=<SECRET>

# ===== Optional: MinIO / S3; when unset the stack uses local media volume =====
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=<SECRET>
# MINIO_SECRET_KEY=<SECRET>
# MINIO_BUCKET=nqp-staging