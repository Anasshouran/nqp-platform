# ============================================================
# deploy/.env.example
# انسخه إلى deploy/.env على VPS واملأ القيم الفعلية.
# لا ترفع .env إلى المستودع أبداً — كل القيم هنا افتراضية آمنة للتطوير فقط.
# المرجع: backend/nqp_backend/settings.py
# ============================================================

# ===== الصور (GHCR) — تُترك افتراضياً ما لم ترد تثبيت SHA معيّن =====
# POSTGRES_IMAGE=ghcr.io/anasshouran/postgres:16-alpine
# REDIS_IMAGE=ghcr.io/anasshouran/redis:7-alpine
# BACKEND_IMAGE=ghcr.io/anasshouran/nqp-backend:dev
# FRONTEND_IMAGE=ghcr.io/anasshouran/afyatna-frontend:dev

# ===== Django =====
DEBUG=True
# غيّرها إلى قيمة عشوائية طويلة على VPS (مهمة حتى مع DEBUG=True للحماية الأساسية)
SECRET_KEY=change-me-to-a-long-random-string
# الدومين الأمامي + أسماء الخدمات الداخلية
ALLOWED_HOSTS=dev.afyatna.com,localhost,127.0.0.1,backend
# الرابط العام المطبوع في رموز QR (شهادات التطعيم). اتركه فارغاً في التطوير،
# لكن اضبطه في الإنتاج وإلا صار الرمز يشير إلى مضيف الطلب (خاطئ خلف وكيل عكسي).
# PUBLIC_SITE_URL=https://nqp.gov.sd
# اختياري: مفتاح توقيع JWT مستقل — يترك فارغاً فيُستخدم SECRET_KEY
# JWT_SECRET_KEY=

# ===== PostgreSQL =====
POSTGRES_DB=afyatna
POSTGRES_USER=afyatna
POSTGRES_PASSWORD=change-me-strong
# اسم وحدة الحجم الموجودة على VPS (تحقق أولاً: docker volume ls)
# POSTGRES_VOLUME=deploy_postgres_data

# ===== Redis =====
# يترك فارغاً (بدون كلمة مرور) في التطوير، أو قيمة قوية على VPS
# REDIS_PASSWORD=
# REDIS_VOLUME=deploy_redis_data

# ===== التخزين المحلي للملفات المرفوعة =====
# BACKEND_MEDIA_VOLUME=deploy_backend_media

# ===== MinIO / S3 =====
# MinIO ليس ضمن بيئة Dev الحالية وليست له صورة معكوسة في GHCR.
# يُبقى USE_S3=False (تخزين محلي على backend_media).
USE_S3=False

# ===== منفذ الواجهة الأمامية على الـ Host (مقيّد بـ 127.0.0.1) =====
# يستقبل منه Nginx المضيف: dev.afyatna.com
# FRONTEND_PORT=8080

# ===== WHO / ICD-11 / IHR (اختياري — معطّل افتراضياً) =====
# عقد الإعدادات القانوني معرّف في backend/nqp_backend/settings.py وموثّق في
# apps/who/config.py. التشخيص بلا أي اتصال خارجي:
#   python manage.py who_config_status
#
# الأسرار تُوضع في deploy/.env.who (متجاهَل، chmod 600 على VPS) ولا تُكتب هنا.
# تحذير: WHO_BASE_URL / WHO_TOKEN_URL / WHO_CLIENT_ID / WHO_CLIENT_SECRET أسماء
# قديمة تُقرأ كـfallback لـICD-11 فقط، والاسم القانوني له الأولوية.
WHO_ENABLED=False
# WHO_TIMEOUT=15

# --- ICD-11 ---
# WHO_ICD_BASE_URL=https://id.who.int
# WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
# WHO_ICD_CLIENT_ID=
# WHO_ICD_CLIENT_SECRET=
# WHO_ICD_API_VERSION=v2
# WHO_ICD_SCOPE=icdapi_access

# --- IHR ---
# لا افتراضيات: مسارات الإرسال والحالة تتطلب تأكيد العقد الرسمي من WHO.
# WHO_IHR_BASE_URL=
# WHO_IHR_TOKEN_URL=
# WHO_IHR_CLIENT_ID=
# WHO_IHR_CLIENT_SECRET=
# WHO_IHR_EVENTS_PATH=
# WHO_IHR_STATUS_PATH=

# ===== تجريبي =====
# ENABLE_DEMO_QR=False
