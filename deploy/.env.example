# ============================================================
# deploy/.env.example
# انسخه إلى deploy/.env على VPS واملأ القيم الفعلية.
# لا ترفع .env إلى المستودع أبداً — كل القيم هنا افتراضية آمنة للتطوير فقط.
# المرجع: backend/nqp_backend/settings.py
# ============================================================

# ===== الصور (GHCR) — تُترك افتراضياً ما لم ترد تثبيت SHA معيّن =====
# POSTGRES_IMAGE=ghcr.io/anasshouran/postgres:16-alpine
# REDIS_IMAGE=ghcr.io/anasshouran/redis:7-alpine
# BACKEND_IMAGE=ghcr.io/anasshouran/nqp-backend:dev
# FRONTEND_IMAGE=ghcr.io/anasshouran/afyatna-frontend:dev

# ===== Django =====
DEBUG=True
# غيّرها إلى قيمة عشوائية طويلة على VPS (مهمة حتى مع DEBUG=True للحماية الأساسية)
SECRET_KEY=change-me-to-a-long-random-string
# الدومين الأمامي + أسماء الخدمات الداخلية
ALLOWED_HOSTS=dev.afyatna.com,localhost,127.0.0.1,backend
# اختياري: مفتاح توقيع JWT مستقل — يترك فارغاً فيُستخدم SECRET_KEY
# JWT_SECRET_KEY=

# ===== PostgreSQL =====
POSTGRES_DB=afyatna
POSTGRES_USER=afyatna
POSTGRES_PASSWORD=change-me-strong
# اسم وحدة الحجم الموجودة على VPS (تحقق أولاً: docker volume ls)
# POSTGRES_VOLUME=deploy_postgres_data

# ===== Redis =====
# يترك فارغاً (بدون كلمة مرور) في التطوير، أو قيمة قوية على VPS
# REDIS_PASSWORD=
# REDIS_VOLUME=deploy_redis_data

# ===== التخزين المحلي للملفات المرفوعة =====
# BACKEND_MEDIA_VOLUME=deploy_backend_media

# ===== MinIO / S3 =====
# MinIO ليس ضمن بيئة Dev الحالية وليست له صورة معكوسة في GHCR.
# يُبقى USE_S3=False (تخزين محلي على backend_media).
USE_S3=False

# ===== منفذ الواجهة الأمامية على الـ Host (مقيّد بـ 127.0.0.1) =====
# يستقبل منه Nginx المضيف: dev.afyatna.com
# FRONTEND_PORT=8080

# ===== تجريبي =====
# ENABLE_DEMO_QR=False
