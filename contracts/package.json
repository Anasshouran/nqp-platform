{
  "name": "@afyatna/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contract types & Zod schemas for AFYATNA mobile (and web where applicable). Single source of truth consumed by mobile, web, and contract tests.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./classification": "./src/classification.ts"
  },
  "files": [
    "src",
    "openapi",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "bash ./openapi/export.sh"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
