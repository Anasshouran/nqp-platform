{
  "cli": { "version": ">= 3.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "http://localhost:8000" } },
    "staging": {
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.afyatna.com" },
      "distribution": "internal",
      "autoIncrement": true
    },
    "staging-simulator": {
      "extends": "staging",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": { "env": { "EXPO_PUBLIC_API_URL": "https://afyatna.com" } }
  }
}
